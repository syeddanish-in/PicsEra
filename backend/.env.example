# Server Configuration
PORT=5000
NODE_ENV=development

# Postgres Database (e.g. Neon connection string)
# Example: postgresql://username:password@ep-cool-frog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@your_neon_host/neondb?sslmode=require

# JWT Secret for Auth Sessions
JWT_SECRET=super_secret_picsera_jwt_key_change_in_production

# Frontend Client URL (for CORS and Stripe Redirects)
FRONTEND_URL=http://localhost:5173

# Stripe Payment Configuration (Use Test Mode for Development & Assessment)
# Get your keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_51...your_stripe_test_secret_key
# From Stripe CLI: `stripe listen --forward-to localhost:5000/api/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...your_webhook_signing_secret
